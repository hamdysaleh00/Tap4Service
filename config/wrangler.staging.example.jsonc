// REVIEW TEMPLATE ONLY. No resource is provisioned by this file.
// Copy to wrangler.staging.local.jsonc and insert the staging D1 ID.
// Nested staging hosts require separately verified TLS certificate coverage.
{
  "name": "tap2serve-staging",
  "main": "../dist/server/index.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [{"type":"ESModule", "globs":["**/*.js", "**/*.mjs"]}],
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"../dist/client", "binding":"ASSETS", "run_worker_first":true},
  "vars": {
    "TAP2SERVE_PRODUCTION":"true",
    "TAP2SERVE_STORAGE":"normalized",
    "TAP2SERVE_AUTH":"independent",
    "TAP2SERVE_BASE_DOMAINS":"staging.tap2serve.com"
  },
  "d1_databases": [{"binding":"DB", "database_name":"tap2serve-staging", "database_id":"00000000-0000-4000-8000-000000000000", "migrations_dir":"../db/staged"}],
  "ratelimits": [
    {"name":"PUBLIC_READ_LIMITER", "namespace_id":"4201", "simple":{"limit":1200,"period":60}},
    {"name":"GUEST_WRITE_LIMITER", "namespace_id":"4202", "simple":{"limit":60,"period":60}}
  ],
  "triggers": {"crons":["*/5 * * * *"]},
  "observability": {"enabled":true, "head_sampling_rate":1, "logs":{"enabled":true,"invocation_logs":false}},
  "limits": {"cpu_ms":1000},
  "routes": [
    {"pattern":"staging.tap2serve.com/*", "zone_name":"tap2serve.com"},
    {"pattern":"*.staging.tap2serve.com/*", "zone_name":"tap2serve.com"}
  ]
}
