// REVIEW TEMPLATE ONLY. No DNS, binding, schedule, alert or deployment is created.
// Use an operator-owned config and replace DB identity; set secrets separately.
{
  "name": "tap2serve-production",
  "main": "../dist/server/index.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [{"type":"ESModule", "globs":["**/*.js", "**/*.mjs"]}],
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "../dist/client", "binding":"ASSETS", "run_worker_first": true},
  "vars": {
    "TAP2SERVE_PRODUCTION": "true",
    "TAP2SERVE_STORAGE": "normalized",
    "TAP2SERVE_AUTH": "independent"
  },
  "d1_databases": [{"binding":"DB", "database_name":"tap2serve-production", "database_id":"00000000-0000-4000-8000-000000000000", "migrations_dir":"../db/staged"}],
  "ratelimits": [
    {"name":"PUBLIC_READ_LIMITER", "namespace_id":"4101", "simple":{"limit":1200,"period":60}},
    {"name":"GUEST_WRITE_LIMITER", "namespace_id":"4102", "simple":{"limit":60,"period":60}}
  ],
  "triggers": {"crons":["*/5 * * * *"]},
  "observability": {"enabled":true, "head_sampling_rate":1, "logs":{"enabled":true,"invocation_logs":false}},
  // Measure password KDF and application CPU in staging before setting a budget.
  "limits": {"cpu_ms":1000},
  "routes": [
    {"pattern":"tap2serve.com/*","zone_name":"tap2serve.com"},
    {"pattern":"*.tap2serve.com/*","zone_name":"tap2serve.com"}
  ]
}
